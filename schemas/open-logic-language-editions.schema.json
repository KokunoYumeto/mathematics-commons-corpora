{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/mathematics-commons-corpora/raw/main/schemas/open-logic-language-editions.schema.json",
  "title": "Open Logic Project language-edition registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "updated_at_utc",
    "edition_label",
    "work",
    "editions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "mathematics-commons-open-logic-language-editions/v1"
    },
    "updated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "edition_label": {
      "const": "independently_maintained_ai_produced_no_upstream_endorsement"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "upstream_repository"
      ],
      "properties": {
        "id": {
          "const": "open-logic-project"
        },
        "title": {
          "const": "Open Logic Project"
        },
        "upstream_repository": {
          "const": "https://github.com/OpenLogicProject/OpenLogic"
        }
      }
    },
    "editions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language_tag",
          "language_label",
          "edition_title",
          "version",
          "release_state",
          "production_disclosure",
          "repository_url",
          "release_url",
          "reader_url",
          "source_commit",
          "source_tree",
          "source_unit_coverage",
          "rights_state",
          "license",
          "license_url",
          "zenodo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "language_tag": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "language_label": {
            "type": "string",
            "minLength": 1
          },
          "edition_title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "release_state": {
            "enum": [
              "current",
              "superseded"
            ]
          },
          "production_disclosure": {
            "const": "independently_maintained_ai_produced_no_upstream_endorsement"
          },
          "repository_url": {
            "type": "string",
            "format": "uri"
          },
          "release_url": {
            "type": "string",
            "format": "uri"
          },
          "reader_url": {
            "type": "string",
            "format": "uri"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_tree": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_unit_coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_units",
              "translated_units",
              "label"
            ],
            "properties": {
              "source_units": {
                "type": "integer",
                "minimum": 1
              },
              "translated_units": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$"
              }
            }
          },
          "rights_state": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "license_url": {
            "type": "string",
            "format": "uri"
          },
          "zenodo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept_doi",
              "concept_doi_url",
              "version_doi",
              "version_doi_url"
            ],
            "properties": {
              "concept_doi": {
                "type": "string",
                "pattern": "^10\\.5281/zenodo\\.[0-9]+$"
              },
              "concept_doi_url": {
                "type": "string",
                "format": "uri"
              },
              "version_doi": {
                "type": "string",
                "pattern": "^10\\.5281/zenodo\\.[0-9]+$"
              },
              "version_doi_url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
}
