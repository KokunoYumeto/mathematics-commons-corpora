{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/mathematics-commons-corpora/raw/main/schemas/release-manifest.schema.json",
  "title": "Mathematics Commons release registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated_at_utc", "releases"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "mathematics-commons-release-registry/v1"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "releases": {"type": "array", "items": {"type": "object"}}
  }
}

